{
  "manifest_version": 3,
  "name": "Holiday Chasers Post Helper",
  "version": "1.0.0",
  "description": "Pick a deal post from holidaychasers.ie and drop its caption and poster into the Facebook composer. You press Post.",
  "permissions": ["storage", "clipboardWrite", "downloads"],
  "host_permissions": ["https://holidaychasers.ie/*", "https://www.facebook.com/*"],
  "action": { "default_popup": "popup.html", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://www.facebook.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
